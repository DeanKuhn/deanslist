---
import ProjectLayout from '../../layouts/Project.astro';
import { projects } from '../../data/projects';
import DashboardCallout from '../../components/DashboardCallout.astro';
import KitchenSyncPanel from '../../components/projects/KitchenSyncPanel.astro';
import MusicPipelinePanel from '../../components/projects/MusicPipelinePanel.astro';
import WgupsPanel from '../../components/projects/WgupsPanel.astro';
import MarketCynicPanel from '../../components/projects/MarketCynicPanel.astro';
import type { GetStaticPaths } from 'astro';
export const getStaticPaths: GetStaticPaths = () => {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
};

const { project } = Astro.props;

const STREAMLIT_URL = 'https://kitchensync.streamlit.app/';

const POWERBI_URLS: Record<string, string> = {
  kitchensync: 'https://app.powerbi.com/groups/me/reports/1a4846f5-fc83-4766-ab0a-7db7a0b00da0/d24e24d7b21f280c17ba?experience=power-bi',
  'music-growth-pipeline': 'https://app.powerbi.com/groups/me/reports/a0d9fc1f-0ae9-4896-afc1-8e43ea054d72/730616348ba9d9dea087?experience=power-bi',
};
const powerbiUrl: string | null = POWERBI_URLS[project.slug] ?? null;
const powerbiNote = project.slug === 'kitchensync'
  ? 'Stores ranked by waste % level, drill-through to individual store stats — sales/waste trends and highest-stockout items — plus an item performance page sliced by category or store.'
  : 'Listener growth by tier and genre, a listener count vs. growth rate plot with per-artist drill-through, and an Artist Spotlight page showing listener growth over time and week-over-week change.';
---

<ProjectLayout title={project.title} description={project.tagline}>

  <!-- Back nav -->
  <div class="back-bar">
    <div class="container">
      <a href="/" class="back-link mono">← dean's list</a>
    </div>
  </div>

  <main class="container page">

    <!-- Header -->
    <header class="project-header">
      <div class="header-meta">
        <span class="mono muted category">{project.category}</span>
        <span class="mono muted sep">·</span>
        <span class="mono muted year">{project.year}</span>
        <span class="mono muted sep">·</span>
        <span class:list={['mono', 'status-badge', `status--${project.status}`]}>
          {project.status === 'live' ? '● live'
           : project.status === 'paused' ? '◌ paused'
           : '✓ complete'}
        </span>
      </div>

      <h1 class="project-title">{project.title}</h1>

      <p class="project-tagline">{project.tagline}</p>

      {project.statusNote && (
        <div class="status-note mono muted">{project.statusNote}</div>
      )}

      <a href={project.githubUrl} target="_blank" rel="noopener" class="github-link mono">
        view on github ↗
      </a>
    </header>

    <!-- Live dashboard callout (kitchensync only) -->
    {project.slug === 'kitchensync' && (
      <DashboardCallout
        href={STREAMLIT_URL}
        label="live streamlit dashboard"
        note="This is what kitchen staff cook from all shift — live Kitchen and Chicken production queues plus running waste and sales metrics, refreshed every 5 minutes."
      />
    )}

    <!-- Live web app callout (any project with a deployed liveUrl) -->
    {project.liveUrl && (
      <DashboardCallout
        href={project.liveUrl}
        label="live web app"
        note="This is the actual product, not a demo — search, artist pages, leaderboards, and genre breakdowns, reading live from Postgres through a rate-limited, read-only API layer."
        cta="visit site ↗"
      />
    )}

    <!-- Screenshot (any project with one set) -->
    {project.screenshotUrl && (
      <img
        class="project-screenshot"
        src={project.screenshotUrl}
        alt={`${project.title} screenshot`}
        loading="lazy"
      />
    )}

    <!-- Per-project live results + "how it's built" diagram -->
    {project.slug === 'kitchensync' && <KitchenSyncPanel />}
    {project.slug === 'music-growth-pipeline' && <MusicPipelinePanel />}
    {project.slug === 'package-router' && <WgupsPanel />}
    {project.slug === 'market-cynic-pipeline' && <MarketCynicPanel />}

    <!-- Body -->
    <div class="project-body">

      <div class="section">
        <div class="section-label mono muted">problem</div>
        <p>{project.problem}</p>
      </div>

      <div class="section">
        <div class="section-label mono muted">what i built</div>
        <p>{project.what}</p>
      </div>

      <div class="section">
        <div class="section-label mono muted">{project.highlightsLabel ?? 'highlights'}</div>
        <ul class="highlights">
          {project.highlights.map((h) => (
            <li>
              <span class="accent mono">→</span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </div>

      {project.challenges && (
        <div class="section section--challenges">
          <div class="section-label mono muted">what i learned the hard way</div>
          {project.challenges.split('\n\n').map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}

      <div class="section">
        <div class="section-label mono muted">stack</div>
        <div class="tags">
          {project.techStack.map((t) => (
            <span class="tag mono">{t}</span>
          ))}
        </div>
      </div>

    </div>

    <!-- Live Power BI dashboard callout (kitchensync + music-growth-pipeline) -->
    {powerbiUrl && (
      <DashboardCallout
        href={powerbiUrl}
        label="live power bi dashboard"
        note={powerbiNote}
        footer
      />
    )}

    <!-- Footer -->
    <div class="page-footer">
      <a href="/" class="mono muted">← all projects</a>
      <div class="page-footer-links">
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener" class="mono accent">
            live site ↗
          </a>
        )}
        <a href={project.githubUrl} target="_blank" rel="noopener" class="mono accent">
          github ↗
        </a>
      </div>
    </div>

  </main>
</ProjectLayout>

<style>
  /* Back bar */
  .back-bar {
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 10;
  }

  .back-link {
    font-size: 0.8125rem;
    color: var(--muted);
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* Page */
  .page {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  /* Header */
  .project-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2.5rem;
  }

  .header-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .sep { opacity: 0.3; }
  .category { text-transform: uppercase; letter-spacing: 0.12em; }

  .status--live    { color: #4ade80; }
  .status--paused  { color: var(--muted); }
  .status--complete{ color: var(--muted); }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .project-tagline {
    font-size: 1rem;
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 1rem;
    color: var(--muted);
  }

  .status-note {
    font-size: 0.8rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg-card);
    border-left: 2px solid var(--border);
    border-radius: 0 var(--radius) var(--radius) 0;
    margin-bottom: 1rem;
    max-width: 600px;
  }

  .github-link {
    font-size: 0.875rem;
    display: inline-block;
    margin-top: 0.5rem;
    border: 1px solid var(--accent-dim);
    padding: 0.4rem 0.875rem;
    border-radius: var(--radius);
    transition: background 0.15s;
  }

  .github-link:hover {
    background: var(--accent-dim);
    text-decoration: none;
  }

  /* Body sections */
  .project-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .section-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.625rem;
    opacity: 0.85;
  }

  .section p {
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.8;
    max-width: 700px;
  }

  /* Highlights */
  .highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .highlights li {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text);
    line-height: 1.65;
    max-width: 700px;
  }

  .highlights li .mono {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  /* Challenges */
  .section--challenges {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section--challenges p {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    color: var(--text);
    margin: 0;
  }

  /* Tags */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    font-size: 0.6875rem;
    color: var(--muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.25rem 0.6rem;
    letter-spacing: 0.04em;
  }

  /* Page footer */
  .page-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .page-footer a {
    font-size: 0.8125rem;
  }

  .page-footer-links {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  /* Screenshot */
  .project-screenshot {
    display: block;
    max-width: 100%;
    max-height: 280px;
    width: auto;
    margin: 0 auto 3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
  }
</style>
