---
interface Props {
  href: string;
  label: string;
  note: string;
  footer?: boolean;
  muted?: boolean;
  cta?: string;
}
const { href, label, note, footer = false, muted = false, cta = 'open dashboard ↗' } = Astro.props;
---

<a href={href} target="_blank" rel="noopener" class:list={['dashboard-callout', footer && 'dashboard-callout--footer', muted && 'dashboard-callout--muted']}>
  <div class="dashboard-callout-header">
    <span class:list={['section-label', 'mono', muted ? 'muted' : 'accent']}>{label}</span>
    <span class="dashboard-callout-cta mono">{cta}</span>
  </div>
  <p class="dashboard-callout-note mono muted">
    {note}
  </p>
</a>

<style>
  .dashboard-callout {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 3rem;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }

  .dashboard-callout:hover {
    box-shadow: 0 0 0 1px var(--accent);
    text-decoration: none;
  }

  .dashboard-callout--footer {
    margin-top: 3rem;
  }

  .dashboard-callout--muted {
    border-color: var(--border);
  }

  .dashboard-callout--muted:hover {
    box-shadow: 0 0 0 1px var(--border);
  }

  .dashboard-callout--muted .dashboard-callout-cta {
    color: var(--muted);
  }

  .dashboard-callout-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .dashboard-callout-cta {
    font-size: 0.8125rem;
    color: var(--accent);
    white-space: nowrap;
  }

  .dashboard-callout-note {
    font-size: 0.8125rem;
    line-height: 1.6;
    margin-top: 0.75rem;
  }
</style>
