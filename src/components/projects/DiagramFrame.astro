---
// Shared "how it's built" wrapper. Each project panel supplies its own SVG via the default slot.
---

<div class="diagram-frame">
  <div class="diagram-label mono muted">how it's built</div>
  <slot />
</div>

<style>
  .diagram-frame {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 3rem;
  }

  .diagram-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.85;
  }
</style>
