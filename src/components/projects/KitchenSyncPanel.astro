    <line x1="430" y1="276" x2="430" y2="310" stroke="#7a7f87" stroke-width="1.5"/>
    <polyline points="426,310 430,317 434,310" fill="none" stroke="#7a7f87" stroke-width="1.5"/>
    <text x="438" y="294" dominant-baseline="middle" fill="#7a7f87" font-size="10" font-family="IBM Plex Mono, monospace">git commit + push</text>
    {/* ab_results_v2.json */}
