---
import { fetchKitchenSync, fetchWeatherImpact } from '../../lib/fetchProjectData';
import KitchenSyncChart from '../charts/KitchenSyncChart';
import WeatherImpactChart from '../charts/WeatherImpactChart';
import DashboardCallout from '../DashboardCallout.astro';
import DiagramFrame from './DiagramFrame.astro';

const STREAMLIT_URL = 'https://kitchensync.streamlit.app/';

const kitchenResult = await fetchKitchenSync();
const weatherResult = await fetchWeatherImpact();

const abData = kitchenResult.state === 'ok' ? kitchenResult.data : null;
const weatherData = weatherResult.state === 'ok' ? weatherResult.data : null;

const weatherExtremeAvgGap = weatherData
  ? (weatherData.extreme_heat.service_level_gap_pp + weatherData.extreme_cold.service_level_gap_pp) / 2
  : null;
const weatherGapMultiplier = weatherData && weatherData.neutral.service_level_gap_pp > 0
  ? weatherExtremeAvgGap! / weatherData.neutral.service_level_gap_pp
  : null;
const weatherChartData = weatherData ? {
  labels: ['neutral', 'extreme heat', 'extreme cold', 'precip'],
  mlSvc: [
    weatherData.neutral.ml_service_level,
    weatherData.extreme_heat.ml_service_level,
    weatherData.extreme_cold.ml_service_level,
    weatherData.precip.ml_service_level,
  ],
  baseSvc: [
    weatherData.neutral.baseline_service_level,
    weatherData.extreme_heat.baseline_service_level,
    weatherData.extreme_cold.baseline_service_level,
    weatherData.precip.baseline_service_level,
  ],
} : null;
const weatherStoreDaysTotal = weatherData
  ? weatherData.extreme_heat.store_days + weatherData.extreme_cold.store_days
    + weatherData.precip.store_days + weatherData.neutral.store_days
  : null;

let wasteDeltaPp: number | null = null;
let serviceDeltaPp: number | null = null;
let latestDay: {
  date: string;
  ml: { waste_pct: number; service_level: number };
  baseline: { waste_pct: number; service_level: number };
} | null = null;

const chartData = abData ? {
  dates: abData.daily.map((d) => d.date),
  mlSvc: abData.daily.map((d) => (d.ml.units_sold / (d.ml.units_sold + d.ml.stockouts)) * 100),
  baseSvc: abData.daily.map((d) => (d.baseline.units_sold / (d.baseline.units_sold + d.baseline.stockouts)) * 100),
  mlWaste: abData.daily.map((d) => (d.ml.waste_cost / d.ml.sales_revenue) * 100),
  baseWaste: abData.daily.map((d) => (d.baseline.waste_cost / d.baseline.sales_revenue) * 100),
} : null;

let calloutText: string | null = null;

if (abData) {
  wasteDeltaPp = abData.cumulative.ml_avg_waste_pct - abData.cumulative.baseline_avg_waste_pct;
  serviceDeltaPp = abData.cumulative.ml_avg_service_level - abData.cumulative.base_avg_service_level;
  const d = abData.daily[abData.daily.length - 1];
  if (d) {
    latestDay = {
      date: d.date,
      ml: {
        waste_pct: (d.ml.waste_cost / d.ml.sales_revenue) * 100,
        service_level: (d.ml.units_sold / (d.ml.units_sold + d.ml.stockouts)) * 100,
      },
      baseline: {
        waste_pct: (d.baseline.waste_cost / d.baseline.sales_revenue) * 100,
        service_level: (d.baseline.units_sold / (d.baseline.units_sold + d.baseline.stockouts)) * 100,
      },
    };
  }

  const serviceVerb = serviceDeltaPp >= 0 ? 'lifts' : 'lowers';
  const wasteVerb = wasteDeltaPp >= 0 ? 'adds' : 'lowers';
  const noTradeoff = serviceDeltaPp >= 0 && wasteDeltaPp <= 0;
  calloutText = `ML ${serviceVerb} service level ${serviceDeltaPp >= 0 ? '+' : ''}${serviceDeltaPp.toFixed(1)}pp and ${wasteVerb} waste ${Math.abs(wasteDeltaPp).toFixed(1)}pp${noTradeoff ? ' — ML wins on both.' : ' — the trade-off is the point.'}`;
}
---

{STREAMLIT_URL && (
  <DashboardCallout
    href={STREAMLIT_URL}
    label="live streamlit dashboard"
    note="This is what kitchen staff cook from all shift — live Kitchen and Chicken production queues plus running waste and sales metrics, refreshed every 5 minutes."
  />
)}

{abData && (
  <div class="ab-section">
    <div class="ab-header">
      <span class="section-label mono muted">live results</span>
      <span class="ab-days mono muted">day {abData.cumulative.days_run} of a/b test</span>
    </div>
    {chartData && (
      <div class="live-results-chart">
        <div class="live-results-summary mono muted">
          {chartData.dates[0]} through {chartData.dates.at(-1)}
        </div>
        <KitchenSyncChart
          dates={chartData.dates}
          mlSvc={chartData.mlSvc}
          baseSvc={chartData.baseSvc}
          mlWaste={chartData.mlWaste}
          baseWaste={chartData.baseWaste}
          client:visible
        />
      </div>
    )}
    <div class="ab-daily-label mono muted">cumulative averages</div>
    <div class="ab-grid">
      <div class="ab-card">
        <div class="ab-card-label mono">ml model</div>
        <div class="ab-metric">
          <span class="ab-value accent">{abData.cumulative.ml_avg_waste_pct.toFixed(1)}%</span>
          <span class="ab-key mono muted">avg waste</span>
        </div>
        <div class="ab-metric">
          <span class="ab-value">{abData.cumulative.ml_avg_service_level.toFixed(1)}%</span>
          <span class="ab-key mono muted">service level</span>
        </div>
      </div>
      <div class="ab-card">
        <div class="ab-card-label mono muted">baseline</div>
        <div class="ab-metric">
          <span class="ab-value">{abData.cumulative.baseline_avg_waste_pct.toFixed(1)}%</span>
          <span class="ab-key mono muted">avg waste</span>
        </div>
        <div class="ab-metric">
          <span class="ab-value">{abData.cumulative.base_avg_service_level.toFixed(1)}%</span>
          <span class="ab-key mono muted">service level</span>
        </div>
      </div>
    </div>
    {latestDay && (
      <div class="ab-daily">
        <div class="ab-daily-label mono muted">latest run · {latestDay.date}</div>
        <div class="ab-grid">
          <div class="ab-card">
            <div class="ab-card-label mono">ml model</div>
            <div class="ab-metric">
              <span class="ab-value accent">{latestDay.ml.waste_pct.toFixed(1)}%</span>
              <span class="ab-key mono muted">
                waste
                <span class:list={['delta', latestDay.ml.waste_pct < abData!.cumulative.ml_avg_waste_pct ? 'delta--better' : 'delta--worse']}>
                  {(latestDay.ml.waste_pct - abData!.cumulative.ml_avg_waste_pct) >= 0 ? '+' : ''}{(latestDay.ml.waste_pct - abData!.cumulative.ml_avg_waste_pct).toFixed(1)}pp vs avg
                </span>
              </span>
            </div>
            <div class="ab-metric">
              <span class="ab-value">{latestDay.ml.service_level.toFixed(1)}%</span>
              <span class="ab-key mono muted">
                service level
                <span class:list={['delta', latestDay.ml.service_level > abData!.cumulative.ml_avg_service_level ? 'delta--better' : 'delta--worse']}>
                  {(latestDay.ml.service_level - abData!.cumulative.ml_avg_service_level) >= 0 ? '+' : ''}{(latestDay.ml.service_level - abData!.cumulative.ml_avg_service_level).toFixed(1)}pp vs avg
                </span>
              </span>
            </div>
          </div>
          <div class="ab-card">
            <div class="ab-card-label mono muted">baseline</div>
            <div class="ab-metric">
              <span class="ab-value">{latestDay.baseline.waste_pct.toFixed(1)}%</span>
              <span class="ab-key mono muted">
                waste
                <span class:list={['delta', latestDay.baseline.waste_pct < abData!.cumulative.baseline_avg_waste_pct ? 'delta--better' : 'delta--worse']}>
                  {(latestDay.baseline.waste_pct - abData!.cumulative.baseline_avg_waste_pct) >= 0 ? '+' : ''}{(latestDay.baseline.waste_pct - abData!.cumulative.baseline_avg_waste_pct).toFixed(1)}pp vs avg
                </span>
              </span>
            </div>
            <div class="ab-metric">
              <span class="ab-value">{latestDay.baseline.service_level.toFixed(1)}%</span>
              <span class="ab-key mono muted">
                service level
                <span class:list={['delta', latestDay.baseline.service_level > abData!.cumulative.base_avg_service_level ? 'delta--better' : 'delta--worse']}>
                  {(latestDay.baseline.service_level - abData!.cumulative.base_avg_service_level) >= 0 ? '+' : ''}{(latestDay.baseline.service_level - abData!.cumulative.base_avg_service_level).toFixed(1)}pp vs avg
                </span>
              </span>
            </div>
          </div>
        </div>
      </div>
    )}

    <div class="ab-callout mono">
      {calloutText}
    </div>
  </div>
)}

{weatherData && weatherChartData && (
  <div class="ab-section">
    <div class="ab-header">
      <span class="section-label mono muted">weather impact</span>
      <span class="ab-days mono muted">{weatherStoreDaysTotal!.toLocaleString()} simulated store-days</span>
    </div>

    <div class="weather-cards">
      <div class="weather-card">
        <span class="weather-value accent">+{weatherData.extreme_heat.service_level_gap_pp.toFixed(1)}pp</span>
        <span class="weather-key mono muted">extreme heat · service level</span>
      </div>
      <div class="weather-card">
        <span class="weather-value accent">+{weatherData.extreme_cold.service_level_gap_pp.toFixed(1)}pp</span>
        <span class="weather-key mono muted">extreme cold · service level</span>
      </div>
      {weatherGapMultiplier && (
        <div class="weather-card">
          <span class="weather-value accent">{weatherGapMultiplier.toFixed(1)}x</span>
          <span class="weather-key mono muted">bigger than the neutral-day gap</span>
        </div>
      )}
    </div>

    <WeatherImpactChart
      labels={weatherChartData.labels}
      mlSvc={weatherChartData.mlSvc}
      baseSvc={weatherChartData.baseSvc}
      client:visible
    />

    <div class="ab-callout mono">
      {`On precipitation days ML's service level runs marginally below baseline (${weatherData.precip.service_level_gap_pp.toFixed(1)}pp) — but waste drops to roughly half (${weatherData.precip.ml_waste_pct.toFixed(1)}% vs ${weatherData.precip.baseline_waste_pct.toFixed(1)}%), a trade-off a flat historical average can't make.`}
    </div>
  </div>
)}

