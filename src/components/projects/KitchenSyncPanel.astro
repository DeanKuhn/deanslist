<style>
  .section-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.625rem;
    opacity: 0.85;
  }

  .ab-section {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 3rem;
  }

  .ab-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .ab-days {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    opacity: 0.5;
  }

  .ab-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .ab-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .ab-card-label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .ab-metric {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .ab-value {
    font-family: var(--font-mono);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .ab-value.accent {
    color: var(--accent);
  }

  .ab-key {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ab-daily {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .ab-daily-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.85;
  }

  .delta {
    display: block;
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    margin-top: 0.125rem;
    opacity: 0.7;
  }

  .delta--better { color: #4ade80; }
  .delta--worse  { color: var(--muted); }

  .ab-callout {
    font-size: 0.8125rem;
    color: var(--muted);
    border-left: 2px solid var(--accent);
    padding: 0.5rem 0.875rem;
    line-height: 1.6;
  }

  .live-results-chart {
    margin-bottom: 1.5rem;
  }

  .live-results-summary {
    font-size: 0.8rem;
    margin-bottom: 1.25rem;
    letter-spacing: 0.02em;
  }

  .weather-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .weather-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .weather-value {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .weather-value.accent {
    color: var(--accent);
  }

  .weather-key {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    .ab-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .weather-cards { grid-template-columns: 1fr; }
  }
</style>
