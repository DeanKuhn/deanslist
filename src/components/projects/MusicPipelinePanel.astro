---
import { fetchMusicPipeline, listenerBandLabel, formatListeners } from '../../lib/fetchProjectData';
import DiagramFrame from './DiagramFrame.astro';

const musicResult = await fetchMusicPipeline();
const pipelineStats = musicResult.state === 'ok' ? musicResult.data : null;

// Growth by starting-listener quintile, smallest band first
const rawQuintiles = [...(pipelineStats?.growth_by_size_quintile ?? [])]
  .sort((a, b) => a.quintile - b.quintile);
const sizeQuintiles = rawQuintiles.map((q) => ({
  ...q,
  label: listenerBandLabel(q, rawQuintiles.length),
}));
const quintileMedianMax = Math.max(...sizeQuintiles.map((q) => q.median_pct_growth), 0.0001);

const smallestQ = sizeQuintiles[0];
const largestQ = sizeQuintiles[sizeQuintiles.length - 1];
const quintileCallout = smallestQ && largestQ
  ? `Median growth falls with artist size: ${smallestQ.median_pct_growth.toFixed(2)}% for the smallest fifth (${smallestQ.label} listeners) down to ${largestQ.median_pct_growth.toFixed(2)}% for the largest (${largestQ.label}). Averages run far higher (${smallestQ.avg_pct_growth.toFixed(2)}% in the smallest band) — a thin tail of viral outliers pulls them up, which is why the median is the honest number. ${pipelineStats!.summary.artist_count.toLocaleString()} artists tracked.`
  : '';
---

{pipelineStats && (
  <div class="ab-section">
    <div class="ab-header">
      <span class="section-label mono muted">live pipeline data</span>
      <span class="ab-days mono muted">{pipelineStats.summary.weeks_tracked} weeks of data · updated {pipelineStats.summary.latest_snapshot}</span>
    </div>

    {sizeQuintiles.length > 0 && (
    <div class="quintile-block">
      <div class="ab-daily-label mono muted">median {pipelineStats.summary.weeks_tracked}-week growth by starting listener size</div>
      <div class="quintile-list">
        {sizeQuintiles.map(q => (
          <div class="quintile-row">
            <span class="quintile-band mono">{q.label}</span>
            <div class="quintile-track">
              <div class="quintile-bar" style={`width: ${(q.median_pct_growth / quintileMedianMax) * 100}%`}></div>
            </div>
            <span class="quintile-median mono accent">{q.median_pct_growth.toFixed(2)}%</span>
            <span class="quintile-meta mono muted">
              avg {q.avg_pct_growth.toFixed(2)}% · p90 {q.p90_pct_growth.toFixed(2)}% · n={q.artist_count.toLocaleString()}
            </span>
          </div>
        ))}
      </div>
      <div class="quintile-axis mono muted">
        rows run smallest to largest · quintiles cut on listener count at the start of the window
      </div>
    </div>
    )}

    <div class="ab-daily">
      <div class="ab-daily-label mono muted">fastest-growing artists · {pipelineStats.summary.latest_snapshot}</div>
      <div class="list-scope mono muted">under 250k starting listeners (size bands &lt;10k through 100k–250k), 5,000+ starting — not the full tracked catalogue</div>
      <div class="growth-list">
        {pipelineStats.top_growing_artists.slice(0, 5).map(a => (
          <div class="growth-row">
            <span class="growth-name mono">{a.artist_name}</span>
            <span class="growth-meta mono muted">{formatListeners(a.starting_count)} → {formatListeners(a.ending_count)}</span>
            <span class="growth-value mono accent">+{a.total_pct_growth.toFixed(1)}%</span>
          </div>
        ))}
      </div>
    </div>

    {quintileCallout && (
      <div class="ab-callout mono">
        {quintileCallout}
      </div>
    )}
  </div>
)}

