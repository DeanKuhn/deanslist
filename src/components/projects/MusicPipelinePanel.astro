<style>
  .section-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.625rem;
    opacity: 0.85;
  }

  .ab-section {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 3rem;
  }

  .ab-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .ab-days {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    opacity: 0.5;
  }

  .ab-daily {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .ab-daily-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.85;
  }

  .ab-callout {
    font-size: 0.8125rem;
    color: var(--muted);
    border-left: 2px solid var(--accent);
    padding: 0.5rem 0.875rem;
    line-height: 1.6;
  }

  .quintile-block {
    margin-bottom: 1.25rem;
  }

  .quintile-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .quintile-row {
    display: grid;
    grid-template-columns: 96px 1fr 62px;
    grid-template-areas:
      'band track median'
      'band meta  meta';
    align-items: center;
    gap: 0.25rem 0.875rem;
  }

  .quintile-band {
    grid-area: band;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .quintile-track {
    grid-area: track;
    height: 6px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }

  .quintile-bar {
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
  }

  .quintile-median {
    grid-area: median;
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: right;
  }

  .quintile-meta {
    grid-area: meta;
    font-size: 0.625rem;
    opacity: 0.65;
  }

  .quintile-axis {
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-top: 0.75rem;
    padding-left: calc(96px + 0.875rem);
  }

  .list-scope {
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    opacity: 0.6;
    margin: -0.5rem 0 0.875rem;
  }

  .growth-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .growth-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 1rem;
    align-items: baseline;
    font-size: 0.8125rem;
    padding: 0.375rem 0;
    border-bottom: 1px solid var(--border);
  }

  .growth-row:last-child {
    border-bottom: none;
  }

  .growth-name {
    color: var(--text);
  }

  .growth-meta {
    font-size: 0.6875rem;
    opacity: 0.5;
  }

  .growth-value {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>
